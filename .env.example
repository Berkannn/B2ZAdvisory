# Copy this file to `.env.local` for local development, and set the same
# variables in your hosting provider's project settings (e.g. Vercel ->
# Project -> Settings -> Environment Variables) for production.

# Required: API key from https://resend.com/api-keys
RESEND_API_KEY=

# Optional: inbox that receives contact form submissions.
# Defaults to info@b2zadvisory.com if not set.
CONTACT_TO_EMAIL=info@b2zadvisory.com

# Optional: sender address used in outgoing emails. Until you verify your own
# domain in Resend (Resend dashboard -> Domains), leave this unset — it will
# fall back to Resend's shared test address, which only delivers to the email
# address you signed up to Resend with. Once your domain is verified, set
# this to an address on that domain, e.g. "B2Z Advisory <no-reply@b2zadvisory.com>".
CONTACT_FROM_EMAIL=
